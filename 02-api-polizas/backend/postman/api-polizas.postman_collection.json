              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"polizaCreadaId\", pm.response.json().id);",
                  "pm.test(\"Prima = canon x meses\", () => pm.expect(pm.response.json().valorPrima).to.eql(21600000.00));"
                ]
              }
            }
          ]
