{
  "info": {
    "name": "API Pólizas - Seguros Bolívar",
    "description": "Colección de la prueba técnica. Variables: baseUrl y apiKey. Los ids corresponden a los datos semilla de Flyway (V2). Ejecute la carpeta en orden sobre una base recién iniciada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiKey",
      "value": "123456"
    },
    {
      "key": "polizaCreadaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Pólizas",
      "item": [
        {
          "name": "Listar pólizas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/polizas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "polizas"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar pólizas COLECTIVA ACTIVA",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/polizas?tipo=COLECTIVA&estado=ACTIVA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "polizas"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "COLECTIVA"
                },
                {
                  "key": "estado",
                  "value": "ACTIVA"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Solo colectivas activas\", () => pm.response.json().forEach(p => { pm.expect(p.tipo).to.eql(\"COLECTIVA\"); pm.expect(p.estado).to.eql(\"ACTIVA\"); }));"
                ]
              }
            }
          ]
        },
